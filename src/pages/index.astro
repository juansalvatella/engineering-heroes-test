  // ── Shuffle helper ────────────────────────────────────
  function shuffle<T>(arr: T[]): T[] {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  // ── State ─────────────────────────────────────────────
  let currentQ = 0;
  let selections: (string | null)[] = new Array(questions.length).fill(null);
  let shuffledAnswers: { text: string; hero: string }[][] = questions.map((q) =>
    shuffle(q.answers)
  );

  // ── DOM refs ──────────────────────────────────────────
  const introEl = document.getElementById("intro")!;
  const quizEl = document.getElementById("quiz")!;
  const resultsEl = document.getElementById("results")!;
  const startBtn = document.getElementById("start-btn")!;
  const backBtn = document.getElementById("back-btn")!;
  const progressFill = document.getElementById("progress-fill")!;
  const progressText = document.getElementById("progress-text")!;
  const questionContainer = document.getElementById("question-container")!;
  const questionText = document.getElementById("question-text")!;
  const answersEl = document.getElementById("answers")!;
  const retakeBtn = document.getElementById("retake-btn")!;
  const shareFeedback = document.getElementById("share-feedback")!;
  const shareLinkedin = document.getElementById("share-linkedin")!;
  const shareDownload = document.getElementById("share-download")!;

  // ── Screen switching ──────────────────────────────────
  function showScreen(el: HTMLElement) {
    [introEl, quizEl, resultsEl].forEach((s) => s.classList.remove("active"));
    el.classList.add("active");
    window.scrollTo(0, 0);
  }

  // ── Render question ───────────────────────────────────
  function renderQuestion() {
    const q = questions[currentQ];
    const answers = shuffledAnswers[currentQ];

    progressFill.style.width = `${((currentQ + 1) / questions.length) * 100}%`;
    progressText.textContent = `${currentQ + 1} / ${questions.length}`;
    questionText.textContent = q.text;
    backBtn.hidden = currentQ === 0;

    answersEl.innerHTML = "";
    const letters = ["A", "B", "C", "D", "E"];
    answers.forEach((a, i) => {
      const card = document.createElement("button");
      card.className = "answer-card";
      if (selections[currentQ] === a.hero) card.classList.add("selected");
      card.innerHTML = `<span class="answer-letter">${letters[i]}</span><span class="answer-text">${a.text}</span>`;
      card.addEventListener("click", () => selectAnswer(a.hero));
      answersEl.appendChild(card);
    });
  }

  // ── Select answer ─────────────────────────────────────
  function selectAnswer(hero: string) {
    selections[currentQ] = hero;

    // highlight
    answersEl.querySelectorAll(".answer-card").forEach((card, i) => {
      card.classList.toggle(
        "selected",
        shuffledAnswers[currentQ][i].hero === hero
      );
    });

    // advance after brief pause
    setTimeout(() => {
      if (currentQ < questions.length - 1) {
        currentQ++;
        transitionQuestion();
      } else {
        showResults();
      }
    }, 300);
  }

  // ── Question transition ───────────────────────────────
  function transitionQuestion() {
    questionContainer.classList.add("fade-out");
    setTimeout(() => {
      renderQuestion();
      questionContainer.classList.remove("fade-out");
    }, 200);
  }

  // ── Compute scores ────────────────────────────────────
  function computeScores(): Record<string, number> {
    const scores: Record<string, number> = {};
    for (const key of Object.keys(heroes)) scores[key] = 0;
    for (const s of selections) {
      if (s) scores[s]++;
    }
    return scores;
  }

  // ── Shared state ───────────────────────────────────────
  let lastScores: Record<string, number> = {};
  const heroOrder = ["aquaman", "flash", "priest", "spielberg", "paladin"];

  function getShareUrl(scores: Record<string, number>): string {
    const sorted = Object.entries(scores).sort((a, b) => b[1] - a[1]);
    const winnerId = sorted[0][0];
    const url = new URL(window.location.href);
    url.search = "";
    url.searchParams.set("h", winnerId);
    url.searchParams.set("s", heroOrder.map((h) => scores[h] ?? 0).join(","));
    return url.toString();
  }

  // ── Show results ──────────────────────────────────────
  function showResults(precomputed?: Record<string, number>) {
    const scores = precomputed ?? computeScores();
    const sorted = Object.entries(scores).sort((a, b) => b[1] - a[1]);
    const winnerId = sorted[0][0];
    const winner = heroes[winnerId];
    const maxScore = questions.length;

    // hero card
    document.getElementById("hero-icon")!.textContent = winner.icon;
    const heroName = document.getElementById("hero-name")!;
    heroName.textContent = winner.name;
    heroName.style.color = winner.color;
    document.getElementById("hero-tagline")!.textContent = winner.tagline;
    document.getElementById("hero-description")!.textContent =
      winner.description;

    const traitsEl = document.getElementById("hero-traits")!;
    traitsEl.innerHTML = "";
    winner.traits.forEach((t) => {
      const pill = document.createElement("span");
      pill.className = "trait-pill";
      pill.textContent = t;
      pill.style.borderColor = winner.color + "40";
      pill.style.color = winner.color;
      traitsEl.appendChild(pill);
    });

    document.getElementById("hero-quote")!.textContent = winner.quote;

    const heroCard = document.getElementById("hero-card")!;
    heroCard.style.borderColor = winner.color + "30";

    // score bars
    const barsEl = document.getElementById("score-bars")!;
    barsEl.innerHTML = "";
    sorted.forEach(([id, score]) => {
      const h = heroes[id];
      const pct = Math.round((score / maxScore) * 100);

      const row = document.createElement("div");
      row.className = "score-row";
      row.innerHTML = `
        <div class="score-row-header">
          <span class="score-label">${h.name.replace("The ", "")}</span>
          <span class="score-value">${pct}%</span>
        </div>
        <div class="score-track">
          <div class="score-bar" style="background:${h.color}" data-width="${pct}%"></div>
        </div>
      `;
      barsEl.appendChild(row);
    });

    lastScores = scores;

    // update URL with shareable params
    history.replaceState(null, "", getShareUrl(scores));

    showScreen(resultsEl);

    // animate bars after screen is visible
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        barsEl
          .querySelectorAll<HTMLElement>(".score-bar")
          .forEach((bar) => {
            bar.style.width = bar.dataset.width!;
          });
      });
    });
  }

  // ── Canvas card generation ────────────────────────────
  function wrapText(
    ctx: CanvasRenderingContext2D,
    text: string,
    maxW: number
  ): string[] {
    const words = text.split(" ");
    const lines: string[] = [];
    let cur = "";
    words.forEach((w) => {
      const test = cur ? cur + " " + w : w;
      if (ctx.measureText(test).width > maxW) {
        lines.push(cur);
        cur = w;
      } else {
        cur = test;
      }
    });
    if (cur) lines.push(cur);
    return lines;
  }

  function generateCardImage(): Promise<Blob> {
    return new Promise((resolve) => {
      const W = 1200;
      const H = 630;
      const canvas = document.createElement("canvas");
      canvas.width = W;
      canvas.height = H;
      const ctx = canvas.getContext("2d")!;

      const sorted = Object.entries(lastScores).sort((a, b) => b[1] - a[1]);
      const winnerId = sorted[0][0];
      const winner = heroes[winnerId];

      const font = (w: string, s: number) =>
        `${w} ${s}px -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif`;

      // ── background ──
      ctx.fillStyle = "#060918";
      ctx.fillRect(0, 0, W, H);

      // radial glow on the left side behind icon
      const glow1 = ctx.createRadialGradient(240, 300, 0, 240, 300, 350);
      glow1.addColorStop(0, winner.color + "1a");
      glow1.addColorStop(0.5, winner.color + "08");
      glow1.addColorStop(1, "transparent");
      ctx.fillStyle = glow1;
      ctx.fillRect(0, 0, W, H);

      // ── LEFT SIDE: icon ──
      ctx.font = "220px serif";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillText(winner.icon, 190, H / 2 - 10);

      // ── RIGHT SIDE: name + quote ──
      const rx = 400;
      const rw = W - rx - 60;

      // hero name
      ctx.textAlign = "left";
      ctx.textBaseline = "alphabetic";
      ctx.fillStyle = winner.color;
      ctx.font = font("800", 72);
      ctx.fillText(winner.name, rx, 200);

      // tagline
      ctx.fillStyle = "#8b8fa8";
      ctx.font = font("italic 400", 26);
      ctx.fillText(winner.tagline, rx, 242);

      // short accent line
      ctx.strokeStyle = winner.color + "40";
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(rx, 272);
      ctx.lineTo(rx + 60, 272);
      ctx.stroke();

      // quote — large and prominent
      const rawQuote = winner.quote
        .replace(/\s*\u2014.*$/, "")
        .replace(/^\u201C/, "")
        .replace(/\u201D$/, "");
      ctx.fillStyle = "#d0d4e8";
      ctx.font = font("italic 500", 34);
      const quoteLines = wrapText(ctx, `\u201C${rawQuote}\u201D`, rw);
      let qy = 340;
      quoteLines.forEach((line) => {
        ctx.fillText(line, rx, qy);
        qy += 50;
      });

      // ── CTA bar at the bottom ──
      const ctaH = 72;
      const ctaY = H - ctaH;
      ctx.fillStyle = winner.color;
      ctx.fillRect(0, ctaY, W, ctaH);

      const ctaText = "Discover your engineering superhero archetype \u2192";
      ctx.font = font("700", 24);
      ctx.fillStyle = "#060918";
      ctx.textAlign = "center";
      ctx.fillText(ctaText, W / 2, ctaY + 45);

      canvas.toBlob((blob) => resolve(blob!), "image/png");
    });
  }

  // ── Share helpers ─────────────────────────────────────
  function getWinnerId(): string {
    const sorted = Object.entries(lastScores).sort((a, b) => b[1] - a[1]);
    return sorted[0][0];
  }

  function getWinnerInfo() {
    return heroes[getWinnerId()];
  }

  function getOgShareUrl(): string {
    const base = import.meta.env.BASE_URL;
    const url = new URL(window.location.href);
    url.search = "";
    url.hash = "";
    url.pathname = `${base}r/${getWinnerId()}`;
    return url.toString();
  }

  shareLinkedin.addEventListener("click", () => {
    const ogUrl = getOgShareUrl();
    window.open(
      `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(ogUrl)}`,
      "_blank",
      "width=600,height=600"
    );
  });

  shareDownload.addEventListener("click", async () => {
    shareFeedback.textContent = "Generating image\u2026";
    const blob = await generateCardImage();
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "engineering-superhero.png";
    a.click();
    URL.revokeObjectURL(url);
    shareFeedback.textContent = "Image downloaded!";
    setTimeout(() => (shareFeedback.textContent = ""), 2500);
  });

  // ── Event handlers ────────────────────────────────────
  startBtn.addEventListener("click", () => {
    showScreen(quizEl);
    renderQuestion();
  });

  backBtn.addEventListener("click", () => {
    if (currentQ > 0) {
      currentQ--;
      transitionQuestion();
    }
  });

  retakeBtn.addEventListener("click", () => {
    currentQ = 0;
    selections = new Array(questions.length).fill(null);
    shuffledAnswers = questions.map((q) => shuffle(q.answers));
    shareFeedback.textContent = "";
    history.replaceState(null, "", window.location.pathname);
    showScreen(introEl);
  });

  // ── Load from URL params ──────────────────────────────
  (function checkUrlParams() {
    const params = new URLSearchParams(window.location.search);
    const heroId = params.get("h");
    const scoresStr = params.get("s");
    if (!heroId || !scoresStr || !heroes[heroId]) return;
    const vals = scoresStr.split(",").map(Number);
    if (vals.length !== 5 || vals.some(isNaN)) return;
    const scores: Record<string, number> = {};
    heroOrder.forEach((h, i) => (scores[h] = vals[i]));
    showResults(scores);
  })();
</script>
